# Framecraft Studio Environment Configuration (Example)
# Secret API keys must remain server-side and never exposed in browser bundles.

# Server Environment
PORT=3000
NODE_ENV=production

# Storage (S3-compatible object storage for acquired media)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET_NAME=framecraft-studio-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Transcription Engine (OpenAI Whisper)
OPENAI_API_KEY=

# Optional Media Search Provider APIs
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
GIPHY_API_KEY=

# Remote Render Worker Cluster (Optional)
FFMPEG_WORKER_URL=http://localhost:8080/render
